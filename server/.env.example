# Copy to server/.env and fill in.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://ascend:ascend@localhost:5432/ascend
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 'mock' = test the paywall without Google Play (development only). 'play' = real Google Play billing.
BILLING_MODE=mock
PLAY_PACKAGE_NAME=com.ascendprotocol.app
PLAY_SUBSCRIPTION_ID=ascend_monthly
PLAY_TRIAL_OFFER_ID=free-trial-6d
# Service account JSON with Play Developer API access (see docs/PLAY_STORE.md)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/play-service-account.json

# Real-time developer notifications (Pub/Sub push). Use OIDC (recommended) or a shared secret.
# PUBSUB_AUDIENCE=https://api.example.com/v1/billing/google/rtdn
# PUBSUB_SERVICE_ACCOUNT_EMAIL=rtdn-pusher@your-project.iam.gserviceaccount.com
# RTDN_SHARED_SECRET=another-long-random-string
