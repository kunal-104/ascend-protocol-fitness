# Copy to app/.env
# API base URL. Android emulator → host machine is 10.0.2.2. On a physical phone use your computer's LAN IP or your deployed URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# 'mock' skips Google Play and uses the server's /billing/mock/subscribe (server must also run BILLING_MODE=mock)
EXPO_PUBLIC_BILLING_MODE=mock
EXPO_PUBLIC_PLAY_SUBSCRIPTION_ID=ascend_monthly
EXPO_PUBLIC_PLAY_TRIAL_OFFER_ID=free-trial-6d
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
